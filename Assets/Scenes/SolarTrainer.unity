  m_EditorClassIdentifier: Assembly-CSharp::InspectionWizard
  stepLabel: {fileID: 149796120}
  titleText: {fileID: 1978408306}
  bodyText: {fileID: 242599735}
  answerToggles:
  - {fileID: 646562221}
  - {fileID: 1490858145}
  - {fileID: 406758343}
  answerLabels:
  - {fileID: 212114971}
  - {fileID: 1440758150}
  - {fileID: 1187080782}
  feedbackText: {fileID: 224390823}
  backButton: {fileID: 1836245373}
  nextButton: {fileID: 1708507156}
  nextLabel: {fileID: 1710270385}
  questions:
  - text: "\u0429\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u043F\u0435\u0440\u0435\u0434 \u043E\u0431\u0441\u043B\u0443\u0433\u043E\u0432\u0443\u0432\u0430\u043D\u043D\u044F\u043C \u043C\u0435\u0440\u0435\u0436\u0435\u0432\u043E\u0433\u043E \u0456\u043D\u0432\u0435\u0440\u0442\u043E\u0440\u0430?"
    answers:
    - "\u0420\u043E\u0437\u0456\u043C\u043A\u043D\u0443\u0442\u0438 DC- \u0442\u0430 AC-\u0440\u043E\u0437'\u0454\u0434\u043D\u0443\u0432\u0430\u0447\u0456 \u0439 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C \u043D\u0430\u043F\u0440\u0443\u0433\u0438"
    - "\u0417\u0431\u0456\u043B\u044C\u0448\u0438\u0442\u0438 \u043D\u0430\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F \u043D\u0430 \u0456\u043D\u0432\u0435\u0440\u0442\u043E\u0440"
    - "\u041D\u0456\u0447\u043E\u0433\u043E, \u0456\u043D\u0432\u0435\u0440\u0442\u043E\u0440 \u043C\u043E\u0436\u043D\u0430 \u043E\u0431\u0441\u043B\u0443\u0433\u043E\u0432\u0443\u0432\u0430\u0442\u0438 \u043F\u0456\u0434 \u043D\u0430\u043F\u0440\u0443\u0433\u043E\u044E"
    correct: 0
  - text: "\u0417\u0430 \u044F\u043A\u0438\u043C\u0438 \u043E\u0437\u043D\u0430\u043A\u0430\u043C\u0438 \u0432\u0438\u044F\u0432\u043B\u044F\u044E\u0442\u044C \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u0443 \u0444\u043E\u0442\u043E\u0435\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u043D\u0443 \u043F\u0430\u043D\u0435\u043B\u044C?"
    answers:
    - "\u0417\u0430 \u043A\u043E\u043B\u044C\u043E\u0440\u043E\u043C \u0430\u043B\u044E\u043C\u0456\u043D\u0456\u0454\u0432\u043E\u0457 \u0440\u0430\u043C\u0438"
    - "\u0417\u0430 \u0442\u0440\u0456\u0449\u0438\u043D\u0430\u043C\u0438 \u043D\u0430 \u0441\u043A\u043B\u0456, \u043F\u043E\u0442\u0435\u043C\u043D\u0456\u043D\u043D\u044F\u043C \u043A\u043E\u043C\u0456\u0440\u043E\u043A \u0456 \u0441\u043B\u0456\u0434\u0430\u043C\u0438 \u043F\u0435\u0440\u0435\u0433\u0440\u0456\u0432\u0443"
    - "\u041B\u0438\u0448\u0435 \u0437\u0430 \u0432\u0430\u0433\u043E\u044E \u043F\u0430\u043D\u0435\u043B\u0456"
    correct: 1
  - text: "\u0429\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0454 \u0447\u0435\u0440\u0432\u043E\u043D\u0438\u0439 \u0456\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440 Fault \u043D\u0430 \u0456\u043D\u0432\u0435\u0440\u0442\u043E\u0440\u0456?"
    answers:
    - "\u0406\u043D\u0432\u0435\u0440\u0442\u043E\u0440 \u043F\u0440\u0430\u0446\u044E\u0454 \u0432 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u043C\u0443 \u0440\u0435\u0436\u0438\u043C\u0456"
    - "\u0406\u0434\u0435 \u0437\u0430\u0440\u044F\u0434 \u0430\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0430"
    - "\u0410\u0432\u0430\u0440\u0456\u044F \u0430\u0431\u043E \u043F\u043E\u043C\u0438\u043B\u043A\u0430: \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430 \u0434\u0456\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430"
    correct: 2
